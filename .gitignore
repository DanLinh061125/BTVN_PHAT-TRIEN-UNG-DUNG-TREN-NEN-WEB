# Git Ignore - BTVN Phát Triển Ứng Dụng Trên Nền Web
# Bảo mật tuyệt đối không commit thông tin nhạy cảm

# Environment files
.env
.env.local
.env.*.local

# Docker & Container persistent data
nodered/data/
nodered_data/
mariadb/data/
mariadb_data/

# Log files & runtime
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS Generated Files
.DS_Store
Thumbs.db
desktop.ini

# IDE & Editor files
.vscode/
.idea/
*.suo
*.user
*.userosscache
*.sln.docstates

# Temporary files
temp_repo/
tmp/
scratch/
