# =================================================================
# FILE CẤU HÌNH BIẾN MÔI TRƯỜNG MẪU (.env.example)
# BTVN PHÁT TRIỂN ỨNG DỤNG TRÊN NỀN WEB - K59.KMT
# Sinh viên: Nguyễn Phạm Đan Linh
# Hướng dẫn: Copy file này thành .env và điền các giá trị bảo mật thật
# =================================================================

# -----------------------------------------------------------------
# 1. Cloudflare Tunnel Token
# Lấy từ Cloudflare Zero Trust Dashboard (Networks -> Tunnels -> linh-cute)
# -----------------------------------------------------------------
TUNNEL_TOKEN=your_cloudflare_tunnel_token_here

# -----------------------------------------------------------------
# 2. Cấu hình cơ sở dữ liệu MariaDB
# -----------------------------------------------------------------
MYSQL_ROOT_PASSWORD=your_root_password_here
MYSQL_DATABASE=shopdb
MYSQL_USER=webuser
MYSQL_PASSWORD=your_secure_password_here

# -----------------------------------------------------------------
# 3. Port cấu hình nội bộ và quản trị (nếu muốn expose)
# -----------------------------------------------------------------
PMA_PORT=8080
NODERED_PORT=1880
